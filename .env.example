# ============================================================================
# ORBIX SOL — optional AI space guide configuration
# ----------------------------------------------------------------------------
# Both variables are OPTIONAL. With neither set, the guide runs entirely
# offline: explanations are composed from the project's own scientific data and
# spoken by the browser's built-in speech engine. That path costs nothing,
# needs no account, and cannot hallucinate a fact.
#
# ⚠️  THERE IS DELIBERATELY NO API-KEY VARIABLE HERE.
#
# Anything prefixed VITE_ is inlined into the JavaScript bundle at build time
# and is readable by every visitor with devtools open. Putting a provider key in
# this file would not risk exposing it — it would publish it, and the key would
# be billed by whoever found it first.
#
# So both variables below are URLs pointing at an endpoint YOU control (a
# serverless function, or a route on your own server). That endpoint holds the
# real provider key and forwards the request. Copy this file to `.env.local`,
# which Vite already git-ignores.
# ============================================================================

# --- Language model ---------------------------------------------------------
# Your proxy endpoint. Contract:
#   POST  { system: string, messages: { role, content }[] }
#   200   { text: string }        (an OpenAI-shaped `choices[]` body also works)
#
# Unset → the grounded offline narrator answers everything.
VITE_AI_API_URL=

# --- Hosted voice -----------------------------------------------------------
# Your proxy endpoint. Contract:
#   POST  { text: string }
#   200   an audio body (audio/mpeg, audio/wav, …)
#
# Unset → the browser's SpeechSynthesis engine speaks. If a request fails the
# guide falls back to the browser engine rather than going silent.
VITE_TTS_API_URL=
